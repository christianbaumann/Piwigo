{* The names of the faces on the photo, each once, with the x for a region the viewer may delete (decision 0065).
   Written on one line per name: the ", " between names is part of the text editor.js keeps. *}
<span id="persons-names">{foreach from=$PERSONS_NAMES item=person name=persons_row}{if !$smarty.foreach.persons_row.first}, {/if}<span class="persons-name" data-persons-regions="{$person.REGIONS_CSV}" data-persons-deletable="{$person.DELETABLE_CSV}">{if $person.URL}<a class="persons-name-label" href="{$person.URL}">{$person.NAME|escape}</a>{else}<span class="persons-name-label">{$person.NAME|escape}</span>{/if}{if !empty($person.DELETABLE)}<button type="button" class="persons-name-delete" title="{'Remove this person from the photo'|@translate|escape}" aria-label="{'Remove this person from the photo'|@translate|escape}"></button>{/if}</span>{/foreach}</span>
