#------------------------------------------------------------------------------
# ExifTool configuration for the Piwigo photoinfo plugin.
#
# Declares the custom XMP namespace photoinfo writes. Required for writing,
# and for reading DateEDTF back: XMP carries its namespace URI in the packet,
# but without this config exiftool guesses an unknown tag's type and reads
# "1965/1970" as a fraction (exiftool 13.25, measured 2026-10-08).
#
# exiftool takes one -config per run. photoinfo's runs write the standard
# caption slots and this namespace, never provenance's pwgprov tags.
#
# The URI below must stay identical to PHOTOINFO_XMP_NAMESPACE_URI in
# include/functions.inc.php; a unit test asserts the two agree.
#------------------------------------------------------------------------------
%Image::ExifTool::UserDefined::pwginfo = (
    GROUPS        => { 0 => 'XMP', 1 => 'XMP-pwginfo', 2 => 'Image' },
    NAMESPACE     => { 'pwginfo' => 'http://piwigo.org/ns/photoinfo/1.0/' },
    WRITABLE      => 'string',
    Info          => { },
    DateEDTF      => { },
);
%Image::ExifTool::UserDefined = (
    'Image::ExifTool::XMP::Main' => {
        pwginfo => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::pwginfo' } },
    },
);
1;  #end
