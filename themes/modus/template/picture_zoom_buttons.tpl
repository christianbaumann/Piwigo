{* Fork-local: the zoom control for photo.zoom.js, added to #imageToolBar by modus_picture_content(). *}
<a id="zoomOut" class="pwg-state-default pwg-button zoomButton zoomStep" href="#" title="{'Zoom out'|@translate}" rel="nofollow"><span class="pwg-icon pwg-button-text zoomLabel">&minus;</span></a>
<a id="zoomFit" class="pwg-state-default pwg-button zoomButton" href="#" title="{'Fit the photo to the window'|@translate}" rel="nofollow"><span class="pwg-icon pwg-button-text zoomLabel">{'Fit'|@translate}</span></a>
<a id="zoomNatural" class="pwg-state-default pwg-button zoomButton" href="#" title="{'Show the photo at its original size'|@translate}" rel="nofollow"><span class="pwg-icon pwg-button-text zoomLabel">100&nbsp;%</span></a>
<a id="zoomIn" class="pwg-state-default pwg-button zoomButton zoomStep" href="#" title="{'Zoom in'|@translate}" rel="nofollow"><span class="pwg-icon pwg-button-text zoomLabel">+</span></a>
